# ============================================================================
#  环境变量示例
# ----------------------------------------------------------------------------
#  用法：把本文件复制成 .env.local（同目录），按需填值，然后重启 npm run dev。
#        .env.local 已被 .gitignore 的 *.local 规则忽略，不会进版本库。
#
#  ⚠️ 重要：Vite 的 VITE_* 变量会被编译进前端 JS 包，
#     任何人打开浏览器开发者工具都能看到。所以这里只放
#     「被人看见也无所谓」的只读令牌，不要放服务端密钥。
#
#  ⚠️ 几个数据源本身几乎都不需要 Key 就能跑，下面几项基本都是可选优化；
#    唯一「强烈建议填」的是 NASA 的 APOD Key（原因见最后一节）。
# ============================================================================


# ---------------------------------------------------------------------------
#  GitHub —— 可选
# ---------------------------------------------------------------------------
#  作用：把「搜索接口」的匿名限流从 10 次/分钟 提升到 30 次/分钟。
#        TECH 板块的 Repos 用搜索接口取热门项目，频繁切分类时可能撞到限流。
#
#  怎么拿（不需要勾选任何权限，只读 public 信息即可）：
#      1. 登录 GitHub → 右上角头像 → Settings
#      2. 左侧最下面 Developer settings
#      3. Personal access tokens → Fine-grained tokens → Generate new token
#      4. Repository access 选 Public repositories (read-only)
#         （或者直接用 classic token，一个权限都不用勾）
#      5. 复制生成的 token 粘到下面
#
#  格式：ghp_xxxxxxxxxxxxxxxxxxxx  或  github_pat_xxxxxxxxxxxx
VITE_GITHUB_TOKEN=


# ---------------------------------------------------------------------------
#  Hugging Face —— 可选
# ---------------------------------------------------------------------------
#  作用：提高 API 限流；需要访问 gated（受限）模型时也用它。
#        TECH 板块的 Models 浏览热门模型，匿名完全够用。
#
#  怎么拿：登录 huggingface.co → 右上角头像 → Settings → Access Tokens
#          → New token，类型选 read 即可。
#
#  格式：hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_HF_TOKEN=


# ---------------------------------------------------------------------------
#  Hugging Face 端点 —— 可选
# ---------------------------------------------------------------------------
#  留空（推荐）：按顺序用下面两个端点，首包会并发探测，谁先成功用谁，
#               并把结果记住（sessionStorage），后续请求不再重复探测。
#
#      1. https://huggingface.co/api   官方站，直连
#      2. /hf-api                      同源反代 → hf-mirror.com/api
#
#  为什么第二个是「/hf-api」而不是直接写 hf-mirror.com：
#      hf-mirror.com 的服务端不给浏览器返回 CORS 头
#      （curl 带 Origin 能拿到 Access-Control-Allow-Origin，
#        Chrome 里却是 "No 'Access-Control-Allow-Origin' header is present"），
#      所以纯前端跨域直连它必然失败，只能走同源代理。
#
#      · npm run dev / preview  → vite.config.ts 里已经配好，开箱能用
#      · 生产静态托管            → 需要在网关 / CDN 上加一条规则：
#                                   /hf-api/*  →  https://hf-mirror.com/api/*
#        没配这条规则时，前端会正常回落到「取数失败」错误态（带重试按钮），
#        不会白屏；错误文案里也会提示要加这条规则。
#
#  中国大陆的网络经常直连不通 huggingface.co，上面这套会自动切到镜像，
#  通常不需要动这一项。只有以下情况才需要显式指定：
#      · 企业内网自建了镜像 / 代理
#      · 部署环境已经配好了别的反向代理路径
#      · 想强制只走官方站（不接受镜像数据）
#
#  示例（填的是「源站」，代码会自动补 /api）：
#      VITE_HF_ENDPOINT=https://huggingface.co
#      VITE_HF_ENDPOINT=https://your-own-mirror.example.com
VITE_HF_ENDPOINT=


# ---------------------------------------------------------------------------
#  NASA API Key —— PHOTON 板块用（强烈建议填）
# ---------------------------------------------------------------------------
#  作用：PHOTON「光 · 看见宇宙」取的是 NASA 官方 APOD 接口的真实数据：
#            https://api.nasa.gov/planetary/apod
#        这个接口**必须**带 api_key 参数，不填的话代码会自动退化为 NASA 的
#        公共演示 Key「DEMO_KEY」。
#
#  ⚠️ 关于 DEMO_KEY，务必知道这一条：
#       它是**全世界共用的一把演示 Key，只有 10 次/小时**，随时可能被别人刷空。
#       PHOTON 是首屏默认板块，一进站就会取一次数 —— 也就是说，不填自己的 Key，
#       页面会**周期性地**变成失败卡或降级到离线存档。
#       它只适合临时试跑，**不能当默认值交付**。
#
#  怎么拿（免费，1 分钟）：
#      1. 打开 https://api.nasa.gov/
#      2. 填姓名 + 邮箱，点 Signup
#      3. 邮箱里会收到一串 40 位的 Key（形如 AbCdEf123...）
#      4. 本地填在下面；线上必须配在**部署方的构建变量**里（见下）
#    个人 Key 的额度是 1000 次/小时，正常使用完全够。
#
#  ⚠️ 线上必须配在**构建时**：Vite 的 VITE_* 是在打包那一刻写进 JS 的，
#     部署完之后再去服务器上补 .env 是没用的 —— 要在 CI / 部署平台的
#     环境变量里配好再构建。
#
#  ── 没配 Key 时会怎样（兜底顺序见 src/photon/useApodDay.ts）──
#      ① 本地缓存 → ② NASA 官方接口 → ③ public/apod-archive.json 的真实数据存档
#      第 ③ 层是某次真连 NASA 抓下来的**原始响应快照**，不是编的；页面上会
#      **明确标注**「离线存档 · X 月 X 日抓取 · 这不是实时数据」，并给出
#      「重新加载」和「填入我的 Key」两个出口。
#
#  ── 不想动环境变量也行 ──
#      失败卡和存档标注条里都能直接「填入我的 Key」：存在浏览器本地、
#      立即生效、无需重新构建。适合临时救急；长期稳定还是配在这里。
#
#  ⚠️ 不要把 Key 写进任何 .ts/.tsx 源码里。
#     本项目的读法只有一处：src/lib/env.ts。
#
#  ⚠️ 注意 VITE_ 前缀的含义：它会被编译进前端产物，浏览器里能看到。
#     NASA 的 APOD Key 属于「公开只读、被人看到也没关系」的那种，所以可以这么用；
#     但服务端密钥（付费 API、数据库口令）绝不能放这里。
VITE_NASA_API_KEY=
